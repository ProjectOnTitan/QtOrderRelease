{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://projectontitan.github.io/QtOrderRelease/data/releases.schema.json",
  "title": "QtOrder 發布紀錄",
  "description": "發布中心與更新清單唯一的資料來源，用語見 CONTEXT.md。跨欄位規則（版本號遞增、最低支援版本必須是未撤回的穩定版等）由 assets/js/release-model.js 的 checkReleaseRules 檢查。",
  "type": "object",
  "required": [
    "schemaVersion",
    "generatedAt",
    "product",
    "releases"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 2
    },
    "mock": {
      "type": "boolean",
      "description": "true 時頁面頂端顯示「模擬資料」提示，且部署時加上 noindex。放上正式資料後移除或設為 false。"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "description": "本檔最後一次修改的時間，顯示在頁面上的「資料更新」。"
    },
    "minimumVersion": {
      "$ref": "#/$defs/version",
      "description": "最低支援版本：本機版本低於它時，啟動器會強制更新到最新穩定版。必須是一個未撤回的穩定版；有任何版本時必填。"
    },
    "product": {
      "type": "object",
      "required": [
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "repositoryUrl": {
          "type": "string",
          "format": "uri"
        },
        "requirements": {
          "type": "array",
          "description": "所有客戶都適用的系統需求，每項一行純文字。",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "brokerRequirements": {
          "type": "array",
          "description": "各券商額外的前置條件。",
          "items": {
            "type": "object",
            "required": [
              "broker",
              "items"
            ],
            "additionalProperties": false,
            "properties": {
              "broker": {
                "type": "string",
                "minLength": 1
              },
              "items": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    "releases": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/release"
      }
    }
  },
  "$defs": {
    "version": {
      "type": "string",
      "description": "純數字三段，不得有前導零或預覽標記；啟動器以 System.Version 比較（見 docs/adr/0001）。",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$"
    },
    "release": {
      "type": "object",
      "required": [
        "version",
        "channel",
        "publishedAt",
        "assets"
      ],
      "additionalProperties": false,
      "properties": {
        "version": {
          "$ref": "#/$defs/version"
        },
        "channel": {
          "enum": [
            "preview",
            "stable"
          ],
          "description": "目前所在的發布通道。晉升時由 preview 改為 stable 並填入 promotedAt。"
        },
        "publishedAt": {
          "type": "string",
          "format": "date-time",
          "description": "第一次發布的時間：一般版本是發布到預覽版的時間，緊急修正是直接發布為穩定版的時間。"
        },
        "promotedAt": {
          "type": "string",
          "format": "date-time",
          "description": "晉升為穩定版的時間。只有晉升過的穩定版才有。"
        },
        "withdrawn": {
          "type": "object",
          "description": "撤回資訊。有此欄位代表已撤回：保留在歷程中但不再提供下載。",
          "required": [
            "at",
            "reason"
          ],
          "additionalProperties": false,
          "properties": {
            "at": {
              "type": "string",
              "format": "date-time"
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "summary": {
          "type": "string",
          "description": "一句話摘要，顯示在頁面上，也作為更新清單的 description 顯示在啟動器的更新提示。"
        },
        "releaseUrl": {
          "type": "string",
          "format": "uri",
          "description": "對應的 GitHub Release 頁面。"
        },
        "sourceCommit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$",
          "description": "建置來源的 QtOrder commit。晉升時比對分支 HEAD，判斷是否需要重新安裝時當作比對基準（QtOrder ADR-0033）。"
        },
        "requiresInstaller": {
          "type": "boolean",
          "description": "這個版本更新了券商 COM 元件或啟動器，必須用安裝程式安裝，啟動器不會套用更新套件（QtOrder ADR-0035）。"
        },
        "notes": {
          "$ref": "#/$defs/notes"
        },
        "assets": {
          "type": "array",
          "description": "三家券商各有安裝程式與更新套件，共六個。",
          "minItems": 6,
          "maxItems": 6,
          "items": {
            "$ref": "#/$defs/asset"
          }
        }
      }
    },
    "notes": {
      "type": "object",
      "description": "版本說明，依類型分組；每項一行寫給客戶看的純文字，可用反引號標示程式碼或檔名。",
      "additionalProperties": false,
      "properties": {
        "upgradeNotes": {
          "$ref": "#/$defs/noteItems",
          "description": "升級須知"
        },
        "features": {
          "$ref": "#/$defs/noteItems",
          "description": "新功能"
        },
        "improvements": {
          "$ref": "#/$defs/noteItems",
          "description": "改善"
        },
        "fixes": {
          "$ref": "#/$defs/noteItems",
          "description": "修正"
        },
        "knownIssues": {
          "$ref": "#/$defs/noteItems",
          "description": "已知問題"
        }
      }
    },
    "noteItems": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "asset": {
      "type": "object",
      "required": [
        "name",
        "kind",
        "size",
        "sha256",
        "url",
        "broker"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "installer",
            "update"
          ],
          "description": "installer＝安裝程式（客戶第一次安裝用），update＝更新套件（啟動器自動更新用，無法單獨安裝）。"
        },
        "size": {
          "type": "integer",
          "minimum": 1,
          "description": "位元組數"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "broker": {
          "enum": [
            "taishin",
            "zf-mega",
            "capital"
          ]
        }
      }
    }
  }
}
